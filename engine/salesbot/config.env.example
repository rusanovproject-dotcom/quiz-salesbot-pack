# Скопируй в config.env и заполни. config.env в .gitignore — токены не уедут в репозиторий.

# ── Куда складывать карточки ─────────────────────────────────────────
# ВНЕ репозитория: там телефоны и ответы про доход
LEADS_DIR=~/quiz-leads

# ── Мессенджер: нужен один из двух ──────────────────────────────────
# ВКонтакте: Управление сообществом → Работа с API → Ключи доступа
VK_TOKEN=
VK_GROUP_ID=

# Telegram: токен от @BotFather
TELEGRAM_TOKEN=

# Твой id в том же мессенджере — сюда бот стучится, когда застрял
OWNER_ID=

# ── Предохранители на первые дни ────────────────────────────────────
# Задан — бот отвечает ТОЛЬКО на сообщения, начинающиеся с этой строки.
# Живые подписчики бота в это время не видят. Убрал — пошёл боевой режим.
TEST_PREFIX=!test

# 1 — ответы уходят не человеку, а тебе на утверждение. Первые дни держи включённым
DRAFT_MODE=0

# ── Модель ──────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6

# ── Что бот говорит вслух. Пусто → он про это молчит ────────────────
OFFER_NAME=
OFFER_PRICE=
OFFER_PAY_URL=
FREE_URL=
EVENT_NAME=
EVENT_DATE=

# ── Ссылка на диалог с ботом (её отдаёт приёмник в квиз) ────────────
# ВК:       https://vk.me/clubХХХХХХХ
# Telegram: https://t.me/твой_бот
BOT_LINK=
# ref для ВК, start для Telegram
BOT_LINK_PARAM=ref

# ── Класс-диагноз из первого ответа квиза ───────────────────────────
# Ключи те же, что в quiz.config.js → classes. Значения — слова, которые ищем в ответе.
CLASS_MAP={"solo":["сам","один"],"brigade":["бригад"],"studio":["студи","менеджер"],"start":["начина","мало"]}

# ── Дорожки оффера по ответу про размер (Q6) ────────────────────────
# A — можно предлагать платное. B — только бесплатное. Человеку НЕ называется.
# Не совпало ни с чем → B (безопаснее не давить).
TRACK_RULES={"A":["6–10","больше10","больше 10"],"B":["до2","3–5","пропущу"]}
