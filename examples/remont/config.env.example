# Пример заполненного конфига. Токены тут пустые — они в config.env, который не коммитится.

LEADS_DIR=~/quiz-leads

VK_TOKEN=
VK_GROUP_ID=
TELEGRAM_TOKEN=
OWNER_ID=

TEST_PREFIX=!test
DRAFT_MODE=1
CLAUDE_MODEL=claude-sonnet-4-6

# Что бот произносит вслух
OFFER_NAME=разбор приёма заявок, час один на один
OFFER_PRICE=3000 ₽
OFFER_PAY_URL=https://example.com/pay
FREE_URL=https://example.com/checklist
EVENT_NAME=открытый разбор для мастеров
EVENT_DATE=каждый четверг, 19:00

BOT_LINK=https://t.me/example_bot
BOT_LINK_PARAM=start

# Классы: ключи те же, что в quiz.config.js
CLASS_MAP={"solo":["сам","один","руками"],"brigade":["бригад","объектах"],"studio":["студи","менеджер"],"start":["начина","мало объектов"]}

# Дорожки: A — можно платное, B — только бесплатное. Не совпало → B
TRACK_RULES={"A":["6–10","больше 10"],"B":["до 2","3–5","пропущу"]}
